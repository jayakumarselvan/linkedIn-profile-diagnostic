# LLM
# Use any LiteLLM model string, for example:
# openai/gpt-4o-mini, anthropic/claude-3-5-sonnet-20240620,
# gemini/gemini-1.5-pro, groq/llama-3.1-70b-versatile, openrouter/google/gemini-pro
LLM_MODEL=groq/openai/gpt-oss-120b
LLM_TEMPERATURE=0.1

# Add the provider key expected by LiteLLM, for example:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Optional web search providers. The app still works with manual public source URLs.
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
SERPAPI_API_KEY=

# Optional runtime tuning
MAX_SOURCE_CHARS=9000
REQUEST_TIMEOUT_SECONDS=20
